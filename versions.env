# =============================================================================
# k8s-builder 组件版本集中配置
# 说明：
#   - 本文件仅管理“非 Chart”组件的版本；Chart 版本统一在 charts.yaml 中维护。
#   - CI 流水线通过 `set -a; . versions.env; set +a` 加载后注入环境变量。
#   - 架构固定为 linux/amd64。
# =============================================================================

# ---- 架构 -------------------------------------------------------------------
OS=linux
ARCH=amd64

# ---- 证书工具 ----------------------------------------------------------------
CFSSL_VERSION=1.7.1
CFSSLJSON_VERSION=1.7.1

# ---- 容器运行时 --------------------------------------------------------------
DOCKER_VERSION=29.9.3
DOCKER_COMPOSE_VERSION=5.7.1
CONTAINERD_VERSION=2.4.2
RUNC_VERSION=1.5.3
CRICTL_VERSION=1.37.0
CRI_DOCKERD_VERSION=0.4.10
CNI_PLUGINS_VERSION=1.10.0

# ---- K8s 及生态 -------------------------------------------------------------
K8S_VERSION=1.37.2
ETCD_VERSION=3.7.3
HELM_VERSION=4.3.2
PAUSE_VERSION=3.10.2

# ---- 网络二进制（calicoctl 为独立二进制，版本与 Calico Chart 无关）-------------
CALICOCTL_VERSION=3.32.4

# ---- Web 组件 ---------------------------------------------------------------
CADDY_VERSION=2.11.9
NGINX_VERSION=1.30.6

# ---- 离线安装器 -------------------------------------------------------------
HARBOR_VERSION=2.15.5
